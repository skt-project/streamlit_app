# Salin file ini menjadi .streamlit/secrets.toml lalu isi nilainya.
# secrets.toml sudah di-gitignore. JANGAN commit credential asli.

# Model sama dengan aplikasi Streamlit lain: [connections.bigquery].
# (Alternatif: nama section [gcp_service_account] juga dibaca.)
[connections.bigquery]
type = "service_account"
project_id = "YOUR_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
client_email = "YOUR_SERVICE_ACCOUNT_EMAIL"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CERT_URL"
universe_domain = "googleapis.com"

[app]
# Spreadsheet utama (ID atau URL lengkap). Harus di-share sebagai Editor ke client_email di atas.
google_sheet_id = "SPREADSHEET_ID_ATAU_URL"
google_sheet_name = "BPOM Audit Stock"      # hanya dipakai bila google_sheet_id kosong (dibuat otomatis bila belum ada)
bigquery_project = "skintific-data-warehouse"
bigquery_dataset = "gt_schema"
bigquery_table = "master_distributor"

# --- Opsional ---
# worksheet_name = "BPOM Audit Stock"       # nama worksheet utama (default sama dengan judul di atas)
# share_with = ["nama@perusahaan.com"]      # email yang diberi akses edit saat spreadsheet dibuat otomatis
# template_path = "D:/path/ke/Contoh Excel Response.xlsx"   # default: folder template/ di aplikasi
