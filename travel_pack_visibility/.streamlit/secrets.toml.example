# Salin menjadi .streamlit/secrets.toml (lokal) atau tempel di Streamlit Cloud > App settings > Secrets.
# secrets.toml TIDAK boleh di-commit (sudah di .gitignore).
# Urutan penting di TOML: tabel [app] dulu, tabel [gcp_service_account] paling bawah.

[app]
# Spreadsheet "Travel Pack Distribution Q4'26" (daftar toko) — URL lengkap atau ID. Share ke service account: Viewer.
store_sheet_id = "URL_ATAU_ID_SPREADSHEET_DAFTAR_TOKO"
# Opsional: nama tab daftar toko. Kosong = semua tab dipindai, dipakai tab pertama yang punya header ASM + Kode Toko.
store_worksheet = ""
# Aturan: toko tampil bila kolom ini >= min_ach_sku.
ach_sku_column = "K"
min_ach_sku = 4

# Spreadsheet hasil submit — share ke service account: Editor. Tab dibuat otomatis bila belum ada.
output_sheet_id = "URL_ATAU_ID_SPREADSHEET_HASIL"
output_worksheet = "TRAVEL_PACK_UPLOAD_LOG"

# Bucket GCS untuk foto (privat). Service account butuh role Storage Object Creator.
evidence_bucket = "NAMA_BUCKET"
evidence_prefix = "Travel Pack Visibility BCD Q4'26"

# Opsional: judul halaman.
# title = "Form Upload Visibility Travel Pack BCD Q4'26"

# Opsional: paksa nama header bila tidak terdeteksi otomatis.
# asm_header = "ASM"
# store_code_header = "Kode ST Toko"
# store_name_header = "Nama Toko"
# spv_header = "SPV"
# region_header = "Region"

# Service account — sama formatnya dengan app Streamlit lain di repo ini.
[gcp_service_account]
type = "service_account"
project_id = "PROJECT_ID"
private_key_id = "ISI_PRIVATE_KEY_ID"
private_key = "TEMPEL_PRIVATE_KEY_DARI_FILE_JSON"
client_email = "NAMA_SERVICE_ACCOUNT@PROJECT_ID.iam.gserviceaccount.com"
client_id = "ISI_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
