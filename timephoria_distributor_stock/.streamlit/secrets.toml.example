# Salin menjadi .streamlit/secrets.toml lalu isi. File asli di-gitignore: JANGAN commit credential.
# Di Streamlit Cloud: App settings -> Secrets -> tempel isi file ini (TOML).
# private_key tetap satu baris dengan \n.

[gcp_service_account]
type = "service_account"
project_id = "YOUR_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
client_email = "YOUR_SERVICE_ACCOUNT_EMAIL"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CERT_URL"

[app]
bigquery_project = "YOUR_PROJECT_ID"
bigquery_dataset = "gt_schema"
bigquery_table = "timephoria_smart_coverage_tester_feedback"
evidence_bucket = "YOUR_BUCKET"
evidence_root_folder = "Timephoria Distributor Stock Evidence"
output_google_sheet_id = "YOUR_OUTPUT_SHEET_ID"
output_worksheet = "Distributor Stock"
# Urutan di sini = urutan tampil. Kode fiktif di contoh; daftar asli hanya di secrets.
sku_codes = ["TST000001", "TST000002", "TST000003"]

# Login tab Admin. Tanpa bagian ini tab Admin nonaktif. Jangan commit password asli.
[admin]
username = "CHANGE_ME"
password = "CHANGE_ME"
