# Template for .streamlit/secrets.toml — copy to secrets.toml and fill in.
# secrets.toml is gitignored. Never commit real values.

# --- BigQuery service account ---
[connections.bigquery]
type = "service_account"
project_id = "skintific-data-warehouse"
private_key_id = "<from the service-account JSON>"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "<service-account>@skintific-data-warehouse.iam.gserviceaccount.com"
client_id = "<from the service-account JSON>"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "<from the service-account JSON>"
universe_domain = "googleapis.com"

# --- BigQuery paths ---
[bigquery]
project = "skintific-data-warehouse"
dataset = "gt_schema"

# --- PJP admin login (salesman_pjp.py) ---
# bcrypt hash only; the plaintext password is never stored anywhere.
# Generate with: python scripts/set_pjp_admin_password.py --username admin
# See docs/distributor-account-management.md section 3.
[admin]
username = "admin"
password_hash = "$2b$12$replace-with-the-hash-the-script-prints"

# For several admins, use a list instead of username/password_hash:
#
# [admin]
# users = [
#   { username = "ops.admin",  password_hash = "$2b$12$..." },
#   { username = "data.admin", password_hash = "$2b$12$..." },
# ]
