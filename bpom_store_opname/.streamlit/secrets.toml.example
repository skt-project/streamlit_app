# Salin file ini menjadi .streamlit/secrets.toml lalu isi nilainya.
# secrets.toml sudah di-gitignore. JANGAN commit credential asli.

# Service account (nama section sama dengan aplikasi Streamlit lain: [connections.bigquery]).
# Google Sheets WAJIB. BigQuery hanya untuk daftar SKU di form "Tambah SKU langsung" (lihat master_product_* di bawah);
# tanpa akses BigQuery, fitur itu memakai reference/Daftar SKU.xlsx bila ada, selain itu nonaktif.
# (Alternatif: nama section [gcp_service_account] juga dibaca.)
[connections.bigquery]
type = "service_account"
project_id = "YOUR_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
client_email = "YOUR_SERVICE_ACCOUNT_EMAIL"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CERT_URL"
universe_domain = "googleapis.com"

[app]
# Spreadsheet utama (ID atau URL lengkap). Harus di-share sebagai Editor ke client_email di atas.
# Di Streamlit Cloud: google_sheet_id harus TEPAT di bawah header [app].
google_sheet_id = "SPREADSHEET_ID_ATAU_URL"

# --- Opsional ---
# worksheet_name = "BPOM Stock Opname Store"   # nama tab (default: BPOM Stock Opname Store; 14 kolom skema toko)
# template_path = "D:/path/ke/Contoh Excel Response.xlsx"   # default: folder template/ di aplikasi

# --- Daftar toko dari Google Sheet (opsional; tanpa ini dipakai reference/Daftar Store.xlsx) ---
# Sheet harus di-share ke client_email di atas (minimal Viewer). Kolom: Region, Nama Group Toko (opsional), Nama Toko.
# store_sheet_id = "ID_ATAU_URL_SHEET_DAFTAR_TOKO"      # URL dengan ?gid=... memilih tab itu; tanpa gid = tab pertama
# store_sheet_gid = 0                                   # alternatif: gid tab secara eksplisit
# store_filter_value = "BA"                             # hanya baris dengan nilai ini di kolom filter; "" = tanpa filter
# store_filter_header = "BA/ Non BA"                    # nama header kolom filter (spasi dan "/" diabaikan)
# store_filter_column = ""                              # huruf kolom cadangan bila header tidak ada (default: tanpa cadangan)

# --- Daftar SKU form "Tambah SKU langsung" (BigQuery; hanya SELECT sku, product_name, pack_size) ---
# Service account butuh BigQuery Data Viewer pada tabel ini + BigQuery Job User pada project.
# master_product_table = "skintific-data-warehouse.gt_schema.master_product"
# master_product_brands = ["SKINTIFIC"]     # default; hanya SKU brand ini yang bisa dipilih
# master_product_exclude_statuses = ["Discontinue", "Discontinued", "Not Sold at GT"]   # default; SKU dengan status ini tidak muncul (huruf besar/kecil bebas)
