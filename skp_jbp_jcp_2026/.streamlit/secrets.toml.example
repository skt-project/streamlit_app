# Salin menjadi .streamlit/secrets.toml (lokal) atau tempel di Streamlit Cloud > App settings > Secrets.
# File secrets.toml TIDAK boleh di-commit (sudah ada di .gitignore).
# Urutan penting di TOML: semua key biasa di atas, tabel [gcp_service_account] paling bawah.

GCP_PROJECT_ID = "PROJECT_ID"
SOURCE_SPREADSHEET_ID = "ISI_ID_SPREADSHEET"
SOURCE_SHEET_NAME = "Template"
LOG_SHEET_NAME = "SKP_UPLOAD_LOG"
GCS_BUCKET = "nama-bucket-skp"
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "ganti-dengan-password-kuat"

# Opsional: "auto" (default) | "live" | "mock"
# APP_MODE = "auto"

# Service account — pilih SATU format.
# Format A (sama dengan app Streamlit lain di repo ini): salin seluruh tabel dari Secrets app lain
# yang memakai service account yang sama.
[gcp_service_account]
type = "service_account"
project_id = "PROJECT_ID"
private_key_id = "ISI_PRIVATE_KEY_ID"
private_key = "TEMPEL_PRIVATE_KEY_DARI_FILE_JSON"
client_email = "NAMA_SERVICE_ACCOUNT@PROJECT_ID.iam.gserviceaccount.com"
client_id = "ISI_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"

# Format B: seluruh isi file JSON service account sebagai string (taruh di ATAS tabel mana pun):
# GCP_SERVICE_ACCOUNT_JSON = '''
# { "type": "service_account", ... isi file JSON ... }
# '''
